generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── AI-Ops ───────────────────────────────────────────────────────────────────

model Metric {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime
  model       String
  latencyP50  Float
  latencyP95  Float
  latencyP99  Float
  throughput  Float
  errorRate   Float
  tokenCount  Int
  createdAt   DateTime @default(now())

  @@index([timestamp])
  @@index([model])
}

model Incident {
  id            String    @id
  title         String
  description   String
  severity      String
  status        String
  affectedModel String
  startedAt     DateTime
  resolvedAt    DateTime?
  errorCount    Int       @default(0)
  impactedUsers Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([severity])
}

model Pipeline {
  id          String    @id
  name        String
  status      String
  triggeredBy String
  startedAt   DateTime
  finishedAt  DateTime?
  totalTokens Int       @default(0)
  costUsd     Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stages      Stage[]

  @@index([status])
}

model Stage {
  id         Int      @id @default(autoincrement())
  pipelineId String
  name       String
  status     String
  durationMs Int?
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
}

// ── Ops Lab ──────────────────────────────────────────────────────────────────

model Account {
  id             String   @id
  name           String
  sbu            String
  function       String
  region         String
  tier           String
  status         String
  annualRevenue  Float
  contactName    String
  contactEmail   String
  accountManager String
  createdAt      DateTime

  @@index([sbu])
  @@index([status])
}

model Quote {
  id          String   @id
  accountId   String
  accountName String
  title       String
  value       Float
  margin      Float
  status      String
  sbu         String
  function    String
  currency    String
  validUntil  DateTime
  owner       String
  createdAt   DateTime

  @@index([accountId])
  @@index([status])
  @@index([sbu])
}

model Order {
  id               String    @id
  quoteId          String
  accountId        String
  accountName      String
  value            Float
  currency         String
  status           String
  sbu              String
  function         String
  orderDate        DateTime
  expectedDelivery DateTime
  actualDelivery   DateTime?
  lineItems        Int
  createdAt        DateTime

  @@index([accountId])
  @@index([status])
  @@index([sbu])
}

model InventoryItem {
  id            String   @id
  sku           String   @unique
  name          String
  category      String
  supplierId    String
  supplierName  String
  quantity      Int
  reorderPoint  Int
  unitCost      Float
  totalValue    Float
  location      String
  status        String
  sbu           String
  function      String
  lastRestocked DateTime
  createdAt     DateTime

  @@index([status])
  @@index([sbu])
  @@index([category])
}

model Supplier {
  id            String   @id
  name          String
  category      String
  country       String
  region        String
  tier          String
  status        String
  annualSpend   Float
  leadTimeDays  Int
  qualityScore  Float
  deliveryScore Float
  contactName   String
  contactEmail  String
  sbu           String
  function      String
  createdAt     DateTime

  @@index([status])
  @@index([tier])
}

model Rebate {
  id                String   @id
  direction         String
  type              String
  counterpartyId    String
  counterpartyName  String
  counterpartyType  String
  targetValue       Float
  achievedValue     Float
  rebateAmount      Float
  currency          String
  period            String
  status            String
  sbu               String
  function          String
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime

  @@index([status])
  @@index([direction])
}

model Project {
  id            String   @id
  name          String
  description   String
  status        String
  phase         String
  sbu           String
  function      String
  owner         String
  sponsor       String
  budget        Float
  spent         Float
  currency      String
  startDate     DateTime
  endDate       DateTime
  completionPct Int
  teamSize      Int
  createdAt     DateTime

  @@index([status])
  @@index([sbu])
}

model Shipment {
  id               String    @id
  orderId          String
  accountId        String
  accountName      String
  carrier          String
  trackingNumber   String
  mode             String
  status           String
  origin           String
  destination      String
  weight           Float
  weightUnit       String
  packages         Int
  shippingCost     Float
  currency         String
  dispatchDate     DateTime
  estimatedDelivery DateTime
  actualDelivery   DateTime?
  sbu              String
  createdAt        DateTime

  @@index([status])
  @@index([orderId])
}

model Invoice {
  id           String    @id
  orderId      String
  accountId    String
  accountName  String
  amount       Float
  tax          Float
  total        Float
  currency     String
  status       String
  paymentTerms String
  issuedDate   DateTime
  dueDate      DateTime
  paidDate     DateTime?
  daysOutstanding Int?
  sbu          String
  function     String
  createdAt    DateTime

  @@index([status])
  @@index([accountId])
  @@index([dueDate])
}

model AiUseCase {
  id                 String    @id
  name               String
  description        String
  domain             String
  status             String
  model              String
  sbu                String
  function           String
  owner              String
  launchDate         DateTime?
  monthlyCallVolume  Int
  avgLatencyMs       Int
  errorRatePct       Float
  estimatedValueUsd  Float
  actualValueUsd     Float
  monthlyCostUsd     Float
  roiMultiple        Float
  createdAt          DateTime

  @@index([status])
  @@index([sbu])
  @@index([domain])
}
