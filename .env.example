DATABASE_URL="file:./dev.db"

# ── Live distributor data seam (optional, all free keys) ─────────────
# When set, product detail pages fetch REAL price/stock/datasheet data for
# real part numbers from distributor APIs. Unset = seam disabled (demo data
# only, clearly labeled simulated).
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# ── Live commodity index seam (optional, free key) ──────────────────
# When set, the landing-view metals strip fetches REAL copper/aluminum prices
# from FRED (Federal Reserve Economic Data, fred.stlouisfed.org — free key),
# converted to $/lb and cited by observation date. Unset = deterministic
# simulated index (clearly labeled). Fetched per request, never stored.
FRED_API_KEY=

# ── Durable persistence seam (optional; dormant until set) ──────────
# POSTGRES_URL activates the Neon-backed server store (durable RFQ intakes and
# any other namespaced KV) over the PersistedRecord table, using Neon's HTTP
# serverless driver — no connection pool, no build-time client generation, works
# on Vercel functions as-is. Unset = per-instance in-memory store. Use the Neon
# *pooled* connection string. The table is created on first write (CREATE TABLE
# IF NOT EXISTS), so no migration step is required to activate.
# Adding Neon via the Vercel Marketplace auto-injects POSTGRES_URL (among others)
# — the app also reads DATABASE_URL / POSTGRES_URL_NON_POOLING / POSTGRES_PRISMA_URL
# as fallbacks, but only when their value is a real postgres:// URL (so the local
# SQLite DATABASE_URL above is correctly ignored).
POSTGRES_URL=

# ── Global rate-limiter seam (optional; dormant until set) ──────────
# When both are set, the public API routes rate-limit through Upstash Redis over
# its REST API — a true cross-instance cap on serverless (one INCR/PEXPIRE/PTTL
# pipeline per request). Unset = per-instance in-memory limiter (best-effort).
# Free Upstash tier is ample for a pilot. A Redis blip falls back to in-memory,
# never 500s the route. The legacy KV_REST_API_URL / KV_REST_API_TOKEN names are
# also accepted, so a Vercel Marketplace Upstash add activates it either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Durable-endpoint auth gate (optional; server-to-server bearer) ──
# The durable business endpoints (/api/jobs, /api/orders, /api/vmi, /api/rfq,
# /api/rfq-responses) accept the app's own same-origin browser requests with no
# secret. Set WRITE_API_TOKEN to also accept server-to-server / agent callers that
# present `Authorization: Bearer <token>` — the MCP server sends it as
# MERIDIAN_API_TOKEN. Anonymous, cross-origin, tokenless callers get 401 either
# way. (Pilot-grade; full per-tenant auth is the dormant SSO seam.)
WRITE_API_TOKEN=

# ── Background-worker signal (optional; informational) ──────────────
# REDIS_URL signals a BullMQ worker *could* be activated for background jobs on a
# separate host (Vercel functions can't run a long-lived worker). Unset = jobs
# run inline. Reported by /api/health as queue:true; no worker ships in-app.
REDIS_URL=
