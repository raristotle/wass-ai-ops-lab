DATABASE_URL="file:./dev.db"

# ── Live distributor data seam (optional, all free keys) ─────────────
# When set, product detail pages fetch REAL price/stock/datasheet data for
# real part numbers from distributor APIs. Unset = seam disabled (demo data
# only, clearly labeled simulated).
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# ── Live commodity index seam (optional, free key) ──────────────────
# When set, the landing-view metals strip fetches REAL copper/aluminum prices
# from FRED (Federal Reserve Economic Data, fred.stlouisfed.org — free key),
# converted to $/lb and cited by observation date. Unset = deterministic
# simulated index (clearly labeled). Fetched per request, never stored.
FRED_API_KEY=
