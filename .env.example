DATABASE_URL="file:./dev.db"

# ── Live distributor data seam (optional, all free keys) ─────────────
# When set, product detail pages fetch REAL price/stock/datasheet data for
# real part numbers from distributor APIs. Unset = seam disabled (demo data
# only, clearly labeled simulated).
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# ── Live commodity index seam (optional, free key) ──────────────────
# When set, the landing-view metals strip fetches REAL copper/aluminum prices
# from FRED (Federal Reserve Economic Data, fred.stlouisfed.org — free key),
# converted to $/lb and cited by observation date. Unset = deterministic
# simulated index (clearly labeled). Fetched per request, never stored.
FRED_API_KEY=

# ── Indicative multi-currency quoting (optional; dormant until set) ──
# Comma list of ISO-4217 codes to show as an INDICATIVE secondary total beside
# the authoritative USD total on quotes (e.g. for CA/MX/export accounts). Rates
# come from the free, no-key Frankfurter API (ECB-sourced), cached once per day.
# Display-only — never touches pricing or payment. Unset = no secondary line, $0.
# FX_QUOTE_CURRENCIES=CAD,MXN

# ── Geocoding seam (optional; dormant until set) ────────────────────
# Address -> lat/long for nearest-branch / jobsite-weather / territory analytics.
# Geocodio is the free primary (2,500/day); Google is a capped fallback that can
# NEVER bill past the free tier (GEO_GOOGLE_MONTHLY_CAP, default 8000; 0 disables
# Google). Coordinates are cached forever. Unset = no geocoding, $0.
# GEOCODIO_API_KEY=
# GOOGLE_MAPS_API_KEY=
# GEO_GOOGLE_MONTHLY_CAP=8000

# ── Address verification seam (optional; dormant until set) ─────────
# USPS Addresses v3 (free, OAuth2, no card) standardizes ship-to/jobsite/will-call
# addresses + ZIP+4. Unset = no verification, $0.
# USPS_CLIENT_ID=
# USPS_CLIENT_SECRET=

# ── Web-grounding fetch seam (optional; dormant until set) ──────────
# Free $0 server-side grounding fetch for Ask Meridian / RAG, SSRF-hardened to an
# explicit trusted-host allow-list. Unset = nothing fetchable, dormant.
# FETCH_GROUNDING_DOMAINS=ul.com,intertek.com

# ── Nameplate OCR seam (optional; dormant until set) ────────────────
# OCR.space (free 25k req/mo, no card) turns a photographed equipment nameplate
# into text; the deterministic parser then extracts specs + a catalog query.
# Unset = the scanner's nameplate-photo option is hidden, $0.
# OCRSPACE_API_KEY=

# ── Durable persistence seam (optional; dormant until set) ──────────
# POSTGRES_URL activates the Neon-backed server store (durable RFQ intakes and
# any other namespaced KV) over the PersistedRecord table, using Neon's HTTP
# serverless driver — no connection pool, no build-time client generation, works
# on Vercel functions as-is. Unset = per-instance in-memory store. Use the Neon
# *pooled* connection string. The table is created on first write (CREATE TABLE
# IF NOT EXISTS), so no migration step is required to activate.
# Adding Neon via the Vercel Marketplace auto-injects POSTGRES_URL (among others)
# — the app also reads DATABASE_URL / POSTGRES_URL_NON_POOLING / POSTGRES_PRISMA_URL
# as fallbacks, but only when their value is a real postgres:// URL (so the local
# SQLite DATABASE_URL above is correctly ignored).
POSTGRES_URL=

# ── Global rate-limiter seam (optional; dormant until set) ──────────
# When both are set, the public API routes rate-limit through Upstash Redis over
# its REST API — a true cross-instance cap on serverless (one INCR/PEXPIRE/PTTL
# pipeline per request). Unset = per-instance in-memory limiter (best-effort).
# Free Upstash tier is ample for a pilot. A Redis blip falls back to in-memory,
# never 500s the route. The legacy KV_REST_API_URL / KV_REST_API_TOKEN names are
# also accepted, so a Vercel Marketplace Upstash add activates it either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Durable-endpoint auth gate (optional; server-to-server bearer) ──
# The durable business endpoints (/api/jobs, /api/orders, /api/vmi, /api/rfq,
# /api/rfq-responses) accept the app's own same-origin browser requests with no
# secret. Set WRITE_API_TOKEN to also accept server-to-server / agent callers that
# present `Authorization: Bearer <token>` — the MCP server sends it as
# MERIDIAN_API_TOKEN. Anonymous, cross-origin, tokenless callers get 401 either
# way. (Pilot-grade; full per-tenant auth is the dormant SSO seam.)
WRITE_API_TOKEN=

# ── Per-tenant SSO / server sessions (optional; upgrade) ────────────
# Set SESSION_SECRET (a long random string) to activate signed server sessions +
# PER-TENANT data isolation: the durable endpoints then require a session cookie
# (browser, after login) or the WRITE_API_TOKEN bearer, and every record is scoped
# to the caller's tenant (one tenant per email domain / IdP claim). Unset = the
# pilot same-origin/token gate with a single shared space (no tenancy).
SESSION_SECRET=
# DEMO_LOGIN_PASSWORD=meridian2024   # shared demo password the /api/auth/login path accepts

# Real OIDC IdP (Azure AD / Okta / Ping) — when set, "Sign in with SSO" does the
# real authorization-code round-trip and /api/auth/sso/callback verifies the
# id_token (JWKS) and maps the tenant from the IdP claim (tid/hd/tenant).
SSO_PROVIDER_NAME=
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_JWKS_URL=
SSO_REDIRECT_URI=
SSO_SCOPE=

# ── Background-worker signal (optional; informational) ──────────────
# REDIS_URL signals a BullMQ worker *could* be activated for background jobs on a
# separate host (Vercel functions can't run a long-lived worker). Unset = jobs
# run inline. Reported by /api/health as queue:true; no worker ships in-app.
REDIS_URL=

# ── Stripe Tax seam (optional; dormant until set) — docs/stripe-tax.md ───────
# Server-only secret key. When set, /api/tax/quote computes real sales tax via
# Stripe's Tax *Calculations* API (a calculation is never billed; this seam never
# creates a tax transaction, so it stays $0 even when active). Unset = the route
# returns {configured:false} and makes no Stripe call. NEVER use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Optional: pin the Stripe API version so a default bump can't change the shape.
# STRIPE_API_VERSION=2026-05-27.dahlia

# ── Stripe deposit collection (optional; dormant) — docs/deposits.md ─────────
# REUSES STRIPE_SECRET_KEY above (same key gates both the Tax calc and deposits).
# This is the ONLY money-moving surface: a deposit Checkout Session is created
# ONLY on an explicit operator "Request deposit" click (POST /api/payments/deposit),
# never automatically, never on a schedule. Card + ACH; no card data touches the
# app (hosted Checkout). Unset STRIPE_SECRET_KEY = {enabled:false}, no Stripe call.
# STRIPE_WEBHOOK_SECRET is the whsec_… signing secret used to verify the webhook
# (POST /api/payments/stripe-webhook) that flips a deposit to Paid; without it the
# webhook rejects everything. Server-only; NEVER NEXT_PUBLIC_.
STRIPE_WEBHOOK_SECRET=

# ── PostHog analytics + flags + surveys (optional; dormant) — docs/observability.md ─
# Client gate: unset = posthog-js is never imported (no script, no network).
# NEXT_PUBLIC_ vars are inlined at build time, so set them then redeploy.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server gate (route-handler feature flags); read at runtime, no rebuild needed.
POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry error monitoring + Session Replay (optional; dormant) — docs/observability.md ─
# Both DSNs gate Sentry.init(); unset = no client, no network, build unchanged.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional — readable stack traces (source-map upload at build time only):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional — opt into Session Replay (both default to 0 = off):
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAY_ERROR_RATE=1.0

# ── Read-only Postgres MCP (DEV TOOLING — NOT a Vercel app var) — docs/mcp-servers.md ─
# Set this in your LOCAL shell only (never commit, never add to Vercel). It is a
# read-only Neon connection string consumed by the DBHub MCP server via .mcp.json.
# POSTGRES_RO_URL=postgresql://meridian_ro:<pwd>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Semantic search reranking (optional; dormant) — docs/search-rerank.md ────
# When set, /api/rerank reranks an existing fuzzy candidate list via Cohere
# Rerank v2 (free trial: 1000 calls/mo). Unset = the route returns {enabled:false}
# and callers keep their fuzzy order. Server-only; NEVER NEXT_PUBLIC_. Fail-closed.
COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v4.0-pro   # optional; or rerank-v4.0-fast / rerank-v3.5

# ── Slack alerts (optional; dormant) — docs/slack-alerts.md ──────────────────
# Incoming Webhook URL (the URL IS the secret; bound to one channel). When set,
# high-signal events (e.g. a new order) post to Slack best-effort. Unset = no-op,
# $0, zero network. Slack messaging APIs are free even when active.
SLACK_WEBHOOK_URL=
# SLACK_ALERTS_ENABLED=0   # optional kill-switch: silence without deleting the URL

# ── Parts enrichment (optional; dormant) — Nexar/Octopart — docs/parts-enrichment.md ─
# OAuth2 client-credentials for the Nexar API (Octopart data). When BOTH are set,
# /api/parts/enrich returns manufacturer compliance docs, multi-distributor stock +
# price breaks, datasheets, and second sources for an MPN. Unset = {enabled:false}
# and the caller uses simulated enrichment. Server-only; NEVER NEXT_PUBLIC_.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# ── Authorized-distributor offers (optional; dormant) — ECIA TrustedParts ─────
# docs/data-lanes.md. When set, /api/products/[id]/offers adds real-time stock,
# price breaks, and lead time from ONLY authorized distributors (the differentiator
# vs broker-inclusive feeds) into the aggregated offer ladder. Free token. Unset =
# {enabled:false}, internal-only ladder, $0/zero-network. Server-only.
ECIA_API_KEY=
# ECIA_API_BASE=https://api.trustedparts.com   # optional base override

# ── Multi-distributor aggregate pricing (optional; dormant) — OEMsecrets ───────
# docs/data-lanes.md. When set, /api/products/[id]/offers also adds OEMsecrets'
# broad distributor stock + price breaks (authorized AND independent) to the
# ladder. Free distributor-referral API. Unset = {enabled:false}, $0/zero-network.
# Server-only; NEVER NEXT_PUBLIC_.
OEMSECRETS_API_TOKEN=
# OEMSECRETS_API_BASE=https://oemsecretsapi.com  # optional base override

# ── Jobsite weather (optional; dormant) — NWS api.weather.gov — docs/data-lanes.md
# NWS is free/key-less but requires a User-Agent identifying the app with a contact,
# and our rule is zero network until explicitly enabled — so WEATHER_CONTACT is BOTH
# the dormancy switch AND the NWS identity. When set, /api/weather (and the jobsite
# delivery badge) returns an install-risk outlook; the address path also needs a
# geocoding key. On-demand only — never polled / no cron. Unset = {enabled:false}.
WEATHER_CONTACT=

# ── Shipping rates (optional; dormant) — Shippo — docs/shipping-crm-sms.md ────
# When set, /api/shipping/rates returns real multi-carrier rate quotes. Quoting is
# FREE (Shippo bills only when a label is bought, which this seam never does).
# Use a shippo_test_ key in preview, shippo_live_ in prod. Server-only.
SHIPPO_API_TOKEN=

# ── CRM sync (optional; dormant) — HubSpot — docs/shipping-crm-sms.md ─────────
# Private App token (pat-…). When set, /api/crm/sync upserts a Contact + creates a
# Deal from a won quote. Free CRM tier. Server-only; never NEXT_PUBLIC_.
HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_DEAL_PIPELINE=default       # optional internal pipeline id
# HUBSPOT_DEAL_WON_STAGE=closedwon    # optional internal won dealstage id

# ── CRM sync (optional; dormant) — Salesforce — docs/cross-sell-relations.md (v5-S3 #13) ──
# Both required to activate. When set, POST /api/crm/sync {provider:"salesforce"}
# creates a Contact + Opportunity from a won quote. Server-only; never NEXT_PUBLIC_.
# SALESFORCE_ACCESS_TOKEN=
# SALESFORCE_INSTANCE_URL=            # e.g. https://yourorg.my.salesforce.com
# SALESFORCE_API_VERSION=v60.0        # optional
# SALESFORCE_WON_STAGE=Closed Won     # optional Opportunity StageName

# ── SMS notifications (optional; dormant) — Twilio — docs/shipping-crm-sms.md ─
# When SID + token + a sender are set, /api/sms/send sends a transactional SMS.
# COMPLIANCE: only send to TCPA-opted-in numbers; honor STOP. Server-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=MG...  # alternative sender (handles STOP/compliance)

# ── Branded PDF (optional; dormant) — Gotenberg — docs/branded-pdf.md ─────────
# Self-hosted, MIT-licensed HTML→PDF service (Docker; $0 software). When set,
# POST /api/pdf/quote renders the same branded HTML the quote email uses into a
# server-side PDF (honors white-label mode). Unset = {configured:false} and the
# UI keeps client print-to-PDF. Point at your own instance; server-only.
# GOTENBERG_URL=http://gotenberg:3000

# ── Web push (optional; dormant) — self-hosted VAPID — docs/web-push.md ───────
# No-payload "tickle" push so a closed PWA still gets quote/approval/order alerts.
# Generate a P-256 VAPID keypair (e.g. `npx web-push generate-vapid-keys`). The
# PRIVATE key is the secret (server-only, NEVER NEXT_PUBLIC_). The PUBLIC key is
# safe to expose; the subscribe route serves it to the browser. Unset = the opt-in
# button stays hidden and /api/push/* report {configured:false}. $0, zero network.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:alerts@your-domain.com   # optional contact (RFC 8292)

# ── Quote e-signature (optional; dormant) — Dropbox Sign — docs/esignature.md ─
# When set, a "Send for signature" button appears on open quotes and emails the
# customer a Dropbox Sign link to sign + accept. The API key is BOTH the auth and
# the webhook HMAC key (Dropbox's account Primary Key). DEFAULTS TO TEST MODE
# (free, non-binding, no quota) — set DROPBOX_SIGN_TEST_MODE=false ONLY to send
# legally-binding live signatures (requires a paid Dropbox Sign API plan).
# Server-only; NEVER NEXT_PUBLIC_. Webhook URL: /api/esign/webhook
# Activating the actual signing document also needs GOTENBERG_URL (the quote PDF).
# DROPBOX_SIGN_API_KEY=
# DROPBOX_SIGN_TEST_MODE=true                   # "false" = binding live signatures ($)
# ESIGN_FILE_URL_HOSTS=                          # optional extra doc hostnames (SSRF allowlist)

# ── Audit log signing (optional) — tamper-evident chain — docs/audit-log.md ───
# The HMAC key for the tamper-evident audit chain. Falls back to SESSION_SECRET,
# then a dev constant. Set this (or SESSION_SECRET) for production tamper-evidence
# so a reader of the stored log can't forge entries. Server-only.
# AUDIT_SECRET=

# ── Semantic search (optional; dormant) — embeddings + Neon pgvector — docs/semantic-search.md
# When set, a semantic (embedding-KNN) lane is fused into the shipped keyword+fuzzy
# RRF for better recall. Default provider Voyage AI (voyage-4-lite, 1024-dim) — its
# voyage-4 family includes the first 200M tokens free, so embedding the catalog once
# is $0. Needs Neon (POSTGRES_URL) for the pgvector store too. Unset = the semantic
# lane is skipped and search is unchanged ($0, no network). Server-only.
# After setting the key, run the one-time backfill: POST /api/embeddings/backfill
# (loop offset until done) to populate the vectors. See docs/semantic-search.md.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_PROVIDER=voyage          # voyage | openai | cohere
# EMBEDDINGS_MODEL=                   # optional override (default per provider)

# ── Free-dataset live seams (optional; all dormant) — docs/dataset-ingestion-live-seams.md
# Eight env-gated lookups that enrich the catalog from FREE/public data sources.
# Each is DORMANT and makes ZERO network calls until its switch below is set; every
# one is $0 in normal use (free key or keyless). Server-only. See the doc for the
# per-source activation steps, licensing, and which Meridian surface each feeds.

# ENERGY STAR certified lighting (Socrata, EPA public domain) — lumens/watts/efficacy
# + UPC. Free Socrata app token (register at data.energystar.gov; no card). The token
# is the dormancy switch and also un-throttles + unlocks the restricted lighting tables.
# ENERGY_STAR_APP_TOKEN=
# ENERGY_STAR_DATASET=msj5-kqfv       # optional dataset-id override (default: connected bulbs)

# DLC QPL lighting listing status (DesignLights Consortium). NOTE: the programmatic
# API/token is PAID (per-subscriber); this seam stays dormant until you subscribe and
# set the bearer token. The free MyDLC account only allows manual web search.
# DLC_QPL_API_TOKEN=

# FCC Equipment Authorization (Socrata opendata.fcc.gov, US-gov public domain) —
# FCC ID → grantee/manufacturer + "FCC grantee verified" badge. Free Socrata app token.
# FCC_SOCRATA_APP_TOKEN=

# Open Icecat datasheets (live.icecat.biz) — specs/datasheet PDF/GTIN for sponsoring
# brands. Free Open Icecat account (username = "shopname"); tokens optional but
# recommended for production. LICENSING: mirror image/PDF assets in your own storage
# rather than hot-linking; some brands restrict media to authorized resellers.
# ICECAT_USERNAME=
# ICECAT_API_TOKEN=                   # optional product-data token (api-token header)
# ICECAT_CONTENT_TOKEN=               # optional asset token (content-token header)

# GLEIF live LEI lookup (api.gleif.org) — legal entity + parent/ultimate-parent chain.
# Keyless + CC0; set the base URL to ACTIVATE (the dormancy switch). 60 req/min/IP.
# GLEIF_API_BASE_URL=https://api.gleif.org/api/v1

# Wikidata brand-ownership (query.wikidata.org/sparql) — owner/parent + official/short
# names + GTIN/LEI. Keyless + CC0; the User-Agent is REQUIRED by Wikimedia policy AND
# is the dormancy switch. Use a descriptive contact string.
# WIKIDATA_USER_AGENT=MeridianProductFinder/1.0 (alerts@your-domain.com)

# BLS Producer Price Index (api.bls.gov v2, US-gov public domain) — electrical /
# switchgear / lighting PPI trends for the commodity strip. Free registration key
# (email + org, no card) = 500 queries/day and the dormancy switch.
# BLS_API_KEY=

# OpenEI Utility Rate Database (api.openei.org, CC0) — utility tariffs by jobsite
# address for operating-cost context. Free OpenEI/api.data.gov key (DEMO_KEY only for
# smoke tests — heavily throttled). The real free key is the dormancy switch.
# OPENEI_API_KEY=

# ── Data-ingestion framework (optional; dormant) — docs/data-ingestion-framework.md ──
# Renewable Source-Adapter framework (D1+). $0 by default: only the network-free
# self-test source runs. To declare LIVE schema.org/JSON-LD product-page sources (D1),
# set INGEST_SOURCES to a single-line JSON array of adapter configs:
#   [{"id":"schema-org:acme","label":"ACME pages","segment":"EES",
#     "license":"public product pages; factual specs only","brandFallback":"ACME",
#     "urls":["https://acme.example/p/1","https://acme.example/p/2"]}]
# INGEST_SOURCES=
# Distributor identity harvest (D3) — enrich a seed MPN list's manufacturer + datasheet
# links from Mouser/Digi-Key/Nexar (reuses their keys above). Per their ToS this ingests
# ONLY identity + datasheet URL, never pricing/stock/specs. Active only when a distributor
# key AND this seed list are set (comma/whitespace-separated, capped at 200). This same seed
# list also drives the D5 cross-reference source (Nexar second-source crosses) when Nexar is keyed.
# INGEST_DISTRIBUTOR_MPNS=
# Manufacturer harvest (D4) — harvest attributes + datasheets + accurate IMAGES from
# manufacturers' own product pages (their own images are redistributable, unlike
# distributor content). Single-line JSON array of {brand, urls, segment?}:
#   [{"brand":"Eaton","urls":["https://www.eaton.com/.../br120"]}]
# Each becomes a "manufacturer:<brand>" source; segment auto-derived from the brand map.
# INGEST_MANUFACTURERS=
# CPSC product-recall demand signal (D6) — FREE/keyless U.S. CPSC recalls (public domain).
# Flags any carried product whose model appears in a recall. Free, but per the zero-network
# rule it's an explicit switch: set to 1/true/yes to enable the "demand:cpsc-recalls" source.
# INGEST_CPSC_RECALLS=
