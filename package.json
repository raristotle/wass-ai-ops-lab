{
  "name": "wass-ai-ops-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:perf": "npm run build && vitest run lib/perf-budget.test.ts",
    "coverage": "vitest run --coverage",
    "mcp": "node mcp/meridian-mcp-server.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^0.10.4"
  }
}
